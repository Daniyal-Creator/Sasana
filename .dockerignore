# Docker reads this from the build context root, which is the repository root
# (see docker-compose.yml), so it has to cover every folder.

**/node_modules
**/.next
**/dist

# Never bake secrets into an image layer. Real values arrive at run time through
# docker-compose `env_file`.
**/.env
**/.env.local

.git
.claude
.agents
.scratch
docs
*.md

# The answer cache's database. `COPY backend ./backend` would otherwise bake a
# developer's local answers into an image layer and ship them to the server,
# where the volume mounted over this path is what should hold them.
backend/data
**/*.tsbuildinfo

# frontend/ used to be excluded here, back when the only image was the backend.
# It cannot be: frontend/Dockerfile builds from this same context root, because
# frontend/src imports the shared contract through "@shared/*". Excluding it
# made the frontend build fail on a COPY that silently found nothing.
# The backend image never copies frontend/, so nothing about it changes.
