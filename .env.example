# --- Required ---
# Google Gemini API key (server-side only, never exposed to the client).
# Get a free key at https://aistudio.google.com — see docs/prd.md §14.
# Required: the app fails at startup with a clear message if this is unset.
GEMINI_API_KEY=

# --- Optional (defaults live in lib/env.ts) ---
# Vision model for /api/vision. Latest free Flash generation (PRD §8).
# Note: the 2.5 models are stale - gemini-2.5-flash-lite 404s for new API keys.
GEMINI_VISION_MODEL=gemini-3.6-flash
# Text model for /api/chat
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# App-level timeout for a single Gemini call, in ms. Keep below the platform
# function limit so we return a friendly 504 before the platform kills us.
GEMINI_TIMEOUT_MS=9000
# Backoff before the single retry on a 429, in ms. Set to 0 in tests.
GEMINI_RETRY_BACKOFF_MS=1500
