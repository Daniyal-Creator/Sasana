# dependencies
# Not anchored: there is one node_modules per workspace folder (frontend/,
# backend/), not one at the root.
node_modules/

# next.js
.next/
out/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# env files
# .env.example IS committed on purpose: it documents the required variables
# with no secret values. Only real, filled-in env files are ignored.
.env*.local
.env

# typescript
*.tsbuildinfo
next-env.d.ts

# test output
coverage/

# deployment
.vercel

# editors
.idea
.vscode
*.swp

# --- Local development tooling (not part of the product) ---
# One person's agent setup: installed skills, tool settings, lockfiles. Useful
# while building, and nobody else's business.
#
# AGENTS.md and CLAUDE.md used to be listed here and are not any more. They are
# not personal setup: they carry the UI guardrails and the vocabulary every
# contributor is held to, and more than one person now works in this repo with
# more than one agent. Rules nobody else can read are not rules.
.claude/
.agents/
skills-lock.json
.codex/
.github/agents/
.github/hooks/
.github/skills/

# Working notes and the local issue tracker. Specs that matter live in docs/.
# One exception: an effort worked by more than one person has to travel with
# the repo, or the other people cannot read their own tickets. Only the
# markdown ships. A log, a screenshot, or a pasted .env dropped next to a
# ticket stays on the machine it was written on, because deleting a file after
# it has been pushed does not remove it from the history — the only real remedy
# for a leaked key is revoking it.
#
# The patterns end in `/*` rather than `/` throughout: git will not re-include
# anything whose parent directory is excluded, so ignoring the entries instead
# of the directory itself is what makes every `!` line below work at all.
.scratch/*
!.scratch/explore-approach/
.scratch/explore-approach/*
!.scratch/explore-approach/*.md
!.scratch/explore-approach/issues/
.scratch/explore-approach/issues/*
!.scratch/explore-approach/issues/*.md
# The areas being worked in parallel. Each owner's spec.md has to travel with
# the repo or the others cannot read what "done" means for that area.
!.scratch/geofencing/
.scratch/geofencing/*
!.scratch/geofencing/*.md
!.scratch/geofencing/issues/
.scratch/geofencing/issues/*
!.scratch/geofencing/issues/*.md
!.scratch/assistant/
.scratch/assistant/*
!.scratch/assistant/*.md
!.scratch/assistant/issues/
.scratch/assistant/issues/*
!.scratch/assistant/issues/*.md
# One effort of its own, allow-listed the same way. Its issues are cited by
# ADR-0012, ADR-0013 and guardrails 11.2; left out, those links point at
# nothing.
!.scratch/dummy-sites/
.scratch/dummy-sites/*
!.scratch/dummy-sites/*.md
!.scratch/dummy-sites/issues/
.scratch/dummy-sites/issues/*
!.scratch/dummy-sites/issues/*.md
!.scratch/vision/
.scratch/vision/*
!.scratch/vision/*.md
!.scratch/landing/
.scratch/landing/*
!.scratch/landing/*.md
# Nested scratch dirs inside a workspace stay ignored wholesale. The old
# pattern was `.scratch/`, which matched at any depth; the anchored patterns
# above only cover the root one, so this line restores the rest.
*/.scratch/

# The answer cache's SQLite file. Generated at run time, machine-specific, and
# it would carry one developer's questions into everyone else's checkout.
backend/data/

# Local agent tooling state, not part of the product.
.impeccable/
.codex/
