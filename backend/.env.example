# Copy this file to backend/.env and fill in your own key.
# backend/.env is git-ignored and is never baked into the Docker image.

# --- Required ---
# Google Gemini API key (backend only; the browser never receives it).
# Get a free key, no credit card, at https://aistudio.google.com/apikey
# The server refuses to start with a clear message if this is unset.
GEMINI_API_KEY=

# --- Optional (defaults live in src/lib/env.ts) ---
# Vision model for POST /api/vision. Latest free Flash generation (PRD §8).
# Note: the 2.5 models are stale - gemini-2.5-flash-lite 404s for new API keys.
GEMINI_VISION_MODEL=gemini-3.6-flash
# Text model for POST /api/chat
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# App-level timeout for a single Gemini call, in ms. On expiry the route returns
# a friendly 504 instead of hanging.
#
# Vision and chat are capped separately because their latency differs by an
# order of magnitude: chat is consistently 1.2-1.4s, vision ranges 2.1s to
# 16.9s. Keep both below any request limit your host imposes.
GEMINI_VISION_TIMEOUT_MS=30000
GEMINI_CHAT_TIMEOUT_MS=15000
# Backoff before the single retry on a 429, in ms. Set to 0 in tests.
GEMINI_RETRY_BACKOFF_MS=1500

# --- Answer cache (defaults live in src/lib/env.ts) ---
# Where the cache keeps its SQLite table, relative to the working directory.
# docker-compose mounts a volume here so answers survive a rebuild.
CACHE_DB_PATH=./data/answers.db
# Set to "false" to answer every question from scratch. Misses are still
# counted, so GET /api/stats stays comparable: run the same questions once with
# the cache off and once with it on, and the two readings are the measurement.
CACHE_ENABLED=true

# --- Server (defaults live in src/index.ts) ---
# Port this server listens on. docker-compose sets it explicitly.
PORT=3001
# Browser origins allowed to call this API, comma separated. The frontend calls
# it cross-origin now, so its origin has to appear here.
ALLOWED_ORIGINS=http://localhost:3000
