# Copy this file to frontend/.env. Nothing here is secret.
#
# There is no Gemini key on this side. The frontend never talks to Gemini; it
# talks to the SASANA backend, which holds the key.

# Base URL of the backend. This is the default the code already falls back to,
# so a local checkout works without this file at all once the backend container
# is up. Set it explicitly when the backend runs somewhere else.
NEXT_PUBLIC_API_URL=http://localhost:3001
